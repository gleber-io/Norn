<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ADR-08: MassTransit fixado em versão 8.x exata (Apache-2.0). Nunca 8.*, nunca v9+ (comercial). -->
  <ItemGroup>
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.10" />
  </ItemGroup>

  <!-- ADR-11 (revisado 14/09/2026): xUnit v3 sobre Microsoft.Testing.Platform, não mais a ponte
       VSTest — o SDK 10.0.401 não suporta VSTest para projetos net10.0 com xunit.v3 4.0.x. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <!-- Fase 1: Norn.BuildingBlocks.Telemetry — OTel, sem Instrumentation.Runtime/Process (ver §4, nota) -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
  </ItemGroup>

  <!-- Fase 1: Norn.BuildingBlocks.Web (IFeatureFlags) e Messaging (outbox) — Redis -->
  <ItemGroup>
    <PackageVersion Include="StackExchange.Redis" Version="3.2.1" />
  </ItemGroup>

  <!-- Fase 1: Norn.BuildingBlocks.Web — filtro de validação (§7.1, aplicado por endpoint filter) -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <!-- Fase 2: Norn.Shop.Catalog.API -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Pino explícito: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 traz EFCore 10.0.4 por
         padrão, e Microsoft.EntityFrameworkCore.Design pede 10.0.12 — sem este pino central o
         grafo resolve as duas versões e gera MSB3277 (zero warnings é DoD da Fase 2). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <!-- Fase 3: Norn.Shop.Payment.API — payment.gateway.bypass é lido via IFeatureFlags (Redis, §5.7);
       o teste de integração obrigatório da tarefa 3a precisa de um Redis real, não dublê. -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
  </ItemGroup>

  <!-- Fase 7: Norn.Platform.IntegrationTests — Monitor contra Prometheus real (tarefa 10) via
       container genérico (sem módulo Testcontainers dedicado ao Prometheus). -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
  </ItemGroup>

  <!-- Fase 7: Norn.Knowledge — sem FrameworkReference (biblioteca pura), então o cache de
       IPlatformConfig/ICooldownStore precisa do pacote explícito que o Shop ganha de graça
       via Microsoft.AspNetCore.App. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
  </ItemGroup>

  <!-- Fase 7: Norn.Monitor — leitura de topologia do cluster (ADR-03, verbos de get/list/watch)
       e o BackgroundService de polling (Microsoft.Extensions.Http.Resilience já pinado acima,
       Fase 2). -->
  <ItemGroup>
    <PackageVersion Include="KubernetesClient" Version="19.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- Fase 7: Norn.Analyzer — detecção de anomalia (ML.NET.TimeSeries, tarefa 4). Sem
       FrameworkReference (biblioteca pura de cálculo, ADR-17): DI e IOptions/IConfiguration
       chegam de pacote explícito, não de graça via ASP.NET Core. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.ML" Version="5.0.0" />
    <PackageVersion Include="Microsoft.ML.TimeSeries" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <!-- Fase 8: Norn.Planner — LLM local via IChatClient direto (CLAUDE.md: o conector do Semantic
       Kernel para Ollama não expõe seed nem num_ctx). OllamaApiClient (OllamaSharp) já implementa
       IChatClient (Microsoft.Extensions.AI.Abstractions) diretamente — sem Microsoft.SemanticKernel
       nem Connectors.Ollama (alpha) no meio. Microsoft.Extensions.AI pinado por ser dependência
       transitiva do OllamaSharp (CentralPackageTransitivePinningEnabled). -->
  <ItemGroup>
    <PackageVersion Include="OllamaSharp" Version="5.4.30" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <!-- HttpClient nomeado para o Ollama, sem handler de resiliência: o teto de 10s por tentativa
         (§5.5) é um CancellationTokenSource próprio, não HttpClient.Timeout nem retry automático —
         um retry escondido corromperia a contagem de tentativas que o LlmPlanner já faz na mão. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

</Project>
