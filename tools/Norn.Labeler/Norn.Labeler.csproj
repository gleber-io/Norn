<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Norn.Labeler</RootNamespace>
  </PropertyGroup>

  <!-- Exceção declarada do §4 do Master Plan: Norn.Labeler é um composition root próprio de
       campanha e referencia Norn.Knowledge diretamente (mesma posição do Norn.Worker), para
       escrever em experiment_runs e para o reset de flags/modo/plannerBackend antes de cada
       execução (Fase 12, tarefas 1, 1a, 2a). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="CsvHelper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Platform\Norn.Contracts\Norn.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Platform\Norn.Knowledge\Norn.Knowledge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
