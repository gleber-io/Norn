<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ADR-17: adaptador — fala com o Prometheus e lê topologia do cluster (KubernetesClient,
       apenas verbos de leitura do ADR-03). Biblioteca (Microsoft.NET.Sdk): expõe BackgroundService
       e AddNornMonitor(...), composta pelo Norn.Worker. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="KubernetesClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Norn.Contracts\Norn.Contracts.csproj" />
  </ItemGroup>

</Project>
