{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "ConnectionStrings": {
    "Knowledge": "Host=localhost;Database=norn;Username=norn;Password=norn"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Norn": {
    "Monitor": {
      "PrometheusBaseUrl": "http://localhost:9090",
      "Namespace": "norn-shop",
      "PollInterval": "00:00:05"
    },
    "Analyzer": {
      "Confidence": 95.0,
      "PValueHistoryLength": 30,
      "ChangeHistoryLength": 30,
      "CorrelationWindow": "00:01:00"
    },
    "Planner": {
      "MaxReplicas": 3,
      "DefaultReplicaDelta": 1,
      "RestartPodCooldown": "00:10:00",
      "MaxActionsPerWindow": 3,
      "ActionWindow": "00:15:00",
      "OllamaTimeout": "00:00:10",
      "ModelName": "norn-qwen",
      "OllamaBaseUrl": "http://localhost:11434",
      "Seed": 42,
      "NumCtx": 8192,
      "VerificationWindowSeconds": 120,
      "PromptBudget": {
        "MaxPromptTokens": 4096,
        "CharsPerTokenEstimate": 3
      }
    },
    "Executor": {
      "GeneralCooldown": "00:03:00",
      "CircuitBreakerFailureThreshold": 5,
      "Namespace": "norn-shop",
      "MemoryRestoredThresholdBytes": 200000000,
      "LatencyP99RestoredMs": 300,
      "ErrorRateRestoredPct": 0.1
    }
  }
}
